    end
    
    local sortedKeys = {}
    for k in pairs(saved) do table.insert(sortedKeys, k) end
    table.sort(sortedKeys)
    
    for _, uniqueId in ipairs(sortedKeys) do
        local item = saved[uniqueId]
        local container = create("Frame", listPage, { Size = UDim2.new(1, -8, 0, 35), BackgroundColor3 = Color3.fromRGB(15, 15, 15) }, 6)
