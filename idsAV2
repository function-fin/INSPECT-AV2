-- === FUNÇÕES DE SUPORTE === --
local function create(className, parent, props, cornerRadius)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do inst[k] = v end
    if cornerRadius then Instance.new("UICorner", inst).CornerRadius = UDim.new(0, cornerRadius) end
    inst.Parent = parent
    return inst
end

local function loadSavedAvatars()
    local s, content = pcall(function() return readfile and readfile(FILE_NAME) end)
    if s and content and content ~= "" then
        local ds, decoded = pcall(HttpService.JSONDecode, HttpService, content)
        if ds then return decoded end
    end
    return {}
end

local function saveAvatarToFile(customName, avatarData)
    local saved = loadSavedAvatars()
    local uniqueId = HttpService:GenerateGUID(false)
    saved[uniqueId] = { Id = uniqueId, Name = customName, Data = avatarData, SavedAt = os.date("%d/%m/%Y %H:%M") }
    pcall(function() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(saved)) end end)
end

local function renameAvatarInFile(uniqueId, newName)
    local saved = loadSavedAvatars()
    if saved[uniqueId] then
        saved[uniqueId].Name = newName
        pcall(function() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(saved)) end end)
    end
end

local function removeAvatarFromFile(uniqueId)
    local saved = loadSavedAvatars()
    if saved[uniqueId] then
        saved[uniqueId] = nil
        pcall(function() if writefile then writefile(FILE_NAME, HttpService:JSONEncode(saved)) end end)
    end
end

