local function displayAvatarData(name, data)
    if not data then return end
    listPage.Visible, detailPage.Visible = false, true
    title.Text, currentInspectedName, currentInspectedData = "INSPECIONANDO: " .. name:upper(), name, data
    updateVisibility()

    for _, v in pairs(gridScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    createCard(data.Shirt, "Camisa") createCard(data.Pants, "Calça") createCard(data.Face, "Rosto")
    if data.BodyParts then
        for part, id in pairs(data.BodyParts) do createCard(id, part) end
    end
    if data.Accessories then
        for _, accId in ipairs(data.Accessories) do createCard(accId, "Acessório") end
    end
end

local function inspect(target)
    local char = target and target.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        local s, d = pcall(hum.GetAppliedDescription, hum)
        if s and d then
            local rawData = { Shirt = d.Shirt, Pants = d.Pants, Face = d.Face, Accessories = {}, BodyParts = { Head = d.Head, Torso = d.Torso, LeftArm = d.LeftArm, RightArm = d.RightArm, LeftLeg = d.LeftLeg, RightLeg = d.RightLeg } }
            for _, a in ipairs(d:GetAccessories(true)) do if a.AssetId and a.AssetId ~= 0 then table.insert(rawData.Accessories, a.AssetId) end end
            displayAvatarData(target.Name, rawData)
        end
    end
end

